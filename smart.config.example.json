{
  "models": { "haiku": "haiku", "sonnet": "sonnet", "opus": "opus" },
  "routing": {
    "optimize": "balanced",
    "fastLane": true,
    "trivial": "haiku",
    "small_edit": "sonnet",
    "multi_file": "sonnet",
    "large_build": "sonnet",
    "planner": "opus", "plannerLight": "sonnet",
    "classifier": "haiku", "reviewer": "haiku",
    "keywordRules": [{ "match": "architecture|race condition|deadlock", "tier": "opus" }]
  },
  "escalation": { "retriesPerModel": 1, "ladder": ["haiku", "sonnet", "opus"] },
  "limits": { "maxPlanSteps": 6, "maxContextBytes": 40000, "maxBudgetUsdPerStep": null, "maxBudgetUsdPerTask": null },
  "session": { "resume": true, "cacheTtlSec": 300, "keepWarmTier": true, "maxContextTokens": 80000 },
  "runner": { "permissionMode": "acceptEdits", "bare": false, "leanCalls": true, "keepAlive": true, "autoEffort": true, "extraArgs": [], "effort": {} },
  "review": { "enabled": true },
  "usage": { "downshiftAt": 0.9, "warnAt": 0.8 },
  "verify": { "auto": true, "commands": [], "timeoutSec": 300, "testEveryStep": false },
  "trackerPath": "~/.smart/history.json",
  "conversationsPath": "~/.smart/conversations.json",
  "limitsPath": "~/.smart/limits.json",
  "historyPath": "~/.smart/input-history.json"
}
